<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>mx.openpay.oa.sb</groupId>
		<artifactId>openarch-sb-starter-parent</artifactId>
		<version>3.1.0-SNAPSHOT</version>
		<relativePath />
	</parent>
	<groupId>mx.openpay</groupId>
	<artifactId>openarch-multicountry-poc</artifactId>
	<version>1.0.0-SNAPSHOT</version>
	<name>openarch-multicountry-poc</name>
	<description>openarch-multicountry-poc</description>

	<scm>
		<url>https://bitbucket.org/openpay-dev/openarch-multicountry-poc</url>
	</scm>

	<properties>
		<created.with.archetype>openarch-microservice-anade-archetype</created.with.archetype>
		<created.with.archetype.version>4.0.0-RELEASE</created.with.archetype.version>
		<java.version>21</java.version>
		<maven.compiler.source>${java.version}</maven.compiler.source>
		<maven.compiler.target>${java.version}</maven.compiler.target>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
		<build.number>x00</build.number> <!-- No cambiar, el valor se
		sobreescribe automáticamente en Jenkins -->
	</properties>

	<dependencies>
		<dependency>
			<groupId>mx.openpay.oa.sb</groupId>
			<artifactId>openarch-sb-starter-web</artifactId>
		</dependency>
		<dependency>
			<groupId>mx.openpay.oa.sb</groupId>
			<artifactId>openarch-sb-starter-aws</artifactId>
		</dependency>
		<dependency>
			<groupId>mx.openpay.oa.sb</groupId>
			<artifactId>openarch-sb-starter-logging</artifactId>
		</dependency>
		<dependency>
			<groupId>mx.openpay.oa.sb</groupId>
			<artifactId>openarch-sb-starter-data-jdbc</artifactId>
		</dependency>
		<dependency>
			<groupId>mx.openpay.oa.sb</groupId>
			<artifactId>openarch-sb-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>com.mysql</groupId>
			<artifactId>mysql-connector-j</artifactId>
		</dependency>
		<!--dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
		</dependency-->
		<dependency>
			<groupId>mx.openpay.oa.sb</groupId>
			<artifactId>openarch-sb-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<scope>provided</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
